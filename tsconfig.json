{
  // this config is for the editor, and `npm run check` -
  // our public types are hand-written, in ./types/index.d.ts
  // typing is deliberately loose - the goal is editor help, not full coverage
  "compilerOptions": {
    "target": "es2018",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true /* import './foo.ts' - what nodejs runs directly */,
    "erasableSyntaxOnly": true /* only typescript syntax that nodejs can strip - no enums etc */,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true /* rollup+esbuild makes ./builds - tsc never emits */,
    /* deliberately loose type-checking */
    "strict": false,
    "noImplicitAny": false,
    /* additional checks */
    "noUnusedLocals": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "allowUnreachableCode": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "src/**/*",
    "plugins/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules/*",
    "**/builds/"
  ]
}

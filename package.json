{
  "name": "wtf_wikipedia",
  "description": "parse wikiscript into json",
  "version": "10.4.2",
  "type": "module",
  "main": "src/index.js",
  "module": "builds/wtf_wikipedia.mjs",
  "unpkg": "builds/wtf_wikipedia-client.min.js",
  "browser": "builds/wtf_wikipedia-client.min.js",
  "author": "Spencer Kelly <spencermountain@gmail.com> (http://spencermounta.in)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spencermountain/wtf_wikipedia.git"
  },
  "exports": {
    ".": {
      "browser": {
        "import": {
          "types": "./types/index.d.ts",
          "default": "./builds/wtf_wikipedia-client.mjs"
        },
        "require": {
          "types": "./types/index.d.cts",
          "default": "./builds/wtf_wikipedia-client.min.js"
        }
      },
      "import": {
        "types": "./types/index.d.ts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./builds/wtf_wikipedia.cjs"
      },
      "default": {
        "types": "./types/index.d.ts",
        "default": "./src/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "provenance": true
  },
  "man": [
    "./builds/man/wtf_wikipedia.1"
  ],
  "types": "types/index.d.ts",
  "scripts": {
    "build": "node ./scripts/version.js && rollup -c",
    "build:all": "node ./scripts/buildAll.js",
    "coverage": "nyc -r lcov -n 'src/**/*' -n 'plugins/**/*' npm run test && npm run test:fetch",
    "lint": "eslint ./src/ ./plugins ./tests",
    "prepare": "node ./scripts/install-plugins.js",
    "start": "node ./scripts/demo.js",
    "test": "NODE_NO_WARNINGS=1 tape ./tests/**/*.test.js | tap-dancer",
    "testb": "TESTENV=prod npm run test",
    "test:fetch": "tape ./tests/fetch/*.test.js | tap-dancer",
    "test:integration": "tape ./tests/integration/*.test.js | tap-dancer",
    "watch": "NODE_NO_WARNINGS=1 amble ./scratch.js"
  },
  "bin": {
    "wtf_wikipedia": "cli.js"
  },
  "engines": {
    "node": ">=12.0.0"
  },
  "files": [
    "builds",
    "src",
    "types"
  ],
  "keywords": [
    "wikipedia",
    "wikimedia",
    "wikipedia markup",
    "wikiscript"
  ],
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true,
    "printWidth": 120
  },
  "dependencies": {
    "isomorphic-unfetch": "^3.1.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "amble": "1.3.0",
    "eslint": "10.5.0",
    "eslint-plugin-compat": "7.0.2",
    "eslint-plugin-regexp": "3.1.0",
    "nyc": "18.0.0",
    "rollup": "4.62.2",
    "shelljs": "0.10.0",
    "tap-dancer": "0.3.4",
    "tape": "5.10.2"
  },
  "eslintIgnore": [
    "builds/*.js"
  ],
  "license": "MIT"
}
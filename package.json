{
  "name": "wtf_wikipedia",
  "version": "10.5.0",
  "description": "parse wikiscript into json",
  "license": "MIT",
  "repository": "github:spencermountain/wtf_wikipedia",
  "homepage": "https://huh.wiki",
  "author": "Spencer Kelly <spencermountain@gmail.com> (https://spencermountain.dev)",
  "type": "module",
  "exports": {
    ".": {
      "browser": {
        "import": {
          "types": "./types/index.d.ts",
          "default": "./builds/wtf_wikipedia-client.mjs"
        },
        "require": {
          "types": "./types/index.d.cts",
          "default": "./builds/wtf_wikipedia-client.min.js"
        }
      },
      "import": {
        "types": "./types/index.d.ts",
        "default": "./builds/wtf_wikipedia.mjs"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./builds/wtf_wikipedia.cjs"
      },
      "default": {
        "types": "./types/index.d.ts",
        "default": "./builds/wtf_wikipedia.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./builds/wtf_wikipedia.cjs",
  "module": "./builds/wtf_wikipedia.mjs",
  "browser": "./builds/wtf_wikipedia-client.min.js",
  "types": "./types/index.d.cts",
  "bin": {
    "wtf_wikipedia": "./cli.js"
  },
  "man": [
    "./builds/man/wtf_wikipedia.1"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "provenance": true
  },
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "watch": "node --watch ./scratch.js",
    "version": "node ./scripts/version.js",
    "build": "node ./scripts/version.js && rollup -c",
    "build:all": "pnpm run build && pnpm -r run build",
    "lint": "eslint .",
    "test": "pnpm run test:unit",
    "test:unit": "tape --strict \"tests/unit/**/*.test.js\" | tap-dancer",
    "test:types": "tsc -p ./tests/types && tsc -p ./tests/types/node10.tsconfig.json && tsc -p ./tests/types/plugins.tsconfig.json && tsc -p ./tests/types/plugins-cjs.tsconfig.json",
    "test:plugins": "pnpm -r --workspace-concurrency=1 run test",
    "test:all": "pnpm run test:types && pnpm run test:unit && pnpm run test:plugins && pnpm run lint",
    "test:hmm": "tape --strict \"tests/_hmm/**/*.hmm.js\" | tap-dancer",
    "testb": "TESTENV=prod pnpm run test:all"
  },
  "files": [
    "builds",
    "src",
    "types"
  ],
  "keywords": [
    "wikipedia",
    "wikimedia",
    "wikipedia markup",
    "wikiscript"
  ],
  "devDependencies": {
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-compat": "7.0.2",
    "eslint-plugin-regexp": "3.3.1",
    "rollup": "4.64.6",
    "rollup-plugin-esbuild": "6.2.1",
    "rollup-plugin-filesize-check": "2.0.1",
    "tap-dancer": "0.4.4",
    "tape": "5.10.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.2"
  },
  "unpkg": "builds/wtf_wikipedia-client.min.js",
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true,
    "printWidth": 120
  }
}

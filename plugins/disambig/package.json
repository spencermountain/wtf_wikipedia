{
  "name": "wtf-plugin-disambig",
  "version": "1.0.0",
  "description": "disambig-details plugin for wtf_wikipedia",
  "license": "MIT",
  "repository": "github:spencermountain/wtf_wikipedia",
  "homepage": "https://github.com/spencermountain/wtf_wikipedia/plugins/disambig#readme",
  "author": "Spencer Kelly <spencermountain@gmail.com> (https://spencermountain.dev)",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.ts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./builds/wtf-plugin-disambig.cjs"
      }
    }
  },
  "main": "./src/index.js",
  "module": "./builds/wtf-plugin-disambig.mjs",
  "types": "./types/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "test": "tape ./tests/**/*.test.js | tap-dancer",
    "testb": "TESTENV=prod tape ./tests/**/*.test.js | tap-dancer",
    "build": "rollup -c"
  },
  "files": [
    "builds",
    "src",
    "types"
  ],
  "dependencies": {
    "compromise": "14.15.1",
    "spacetime": "7.12.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "rollup": "4.63.4",
    "rollup-plugin-filesize-check": "1.2.0",
    "tap-dancer": "0.4.0",
    "tape": "5.10.2"
  },
  "peerDependencies": {
    "wtf_wikipedia": ">=10.5.0"
  },
  "unpkg": "./builds/wtf-plugin-disambig.min.js",
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true,
    "printWidth": 100
  }
}

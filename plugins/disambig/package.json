{
  "name": "wtf-plugin-disambig",
  "version": "1.0.0",
  "description": "disambig-details plugin for wtf_wikipedia",
  "license": "MIT",
  "repository": "github:spencermountain/wtf_wikipedia",
  "homepage": "https://github.com/spencermountain/wtf_wikipedia/plugins/disambig#readme",
  "author": "Spencer Kelly <spencermountain@gmail.com> (https://spencermountain.dev)",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.ts",
        "default": "./builds/wtf-plugin-disambig.mjs"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./builds/wtf-plugin-disambig.cjs"
      }
    }
  },
  "main": "./builds/wtf-plugin-disambig.cjs",
  "module": "./builds/wtf-plugin-disambig.mjs",
  "types": "./types/index.d.cts",
  "sideEffects": false,
  "scripts": {
    "build": "rollup -c",
    "test": "tape --strict \"tests/**/*.test.js\" | tap-dancer",
    "test:built": "TESTENV=prod tape --strict \"tests/**/*.test.js\" | tap-dancer",
    "test:all": "pnpm run build && pnpm test && pnpm run test:built"
  },
  "files": [
    "builds",
    "src",
    "types"
  ],
  "dependencies": {
    "compromise": "14.15.1",
    "spacetime": "7.12.1"
  },
  "devDependencies": {
    "wtf_wikipedia": "workspace:*"
  },
  "peerDependencies": {
    "wtf_wikipedia": ">=9.0.0"
  },
  "unpkg": "./builds/wtf-plugin-disambig.min.js"
}

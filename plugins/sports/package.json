{
  "name": "wtf-plugin-sports",
  "version": "0.0.2",
  "description": "plugin for wtf_wikipedia",
  "license": "MIT",
  "repository": "github:spencermountain/wtf_wikipedia",
  "homepage": "https://github.com/spencermountain/wtf_wikipedia/plugins/sports#readme",
  "author": "Spencer Kelly <spencermountain@gmail.com> (https://spencermountain.dev)",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.ts",
        "default": "./builds/wtf-plugin-sports.mjs"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./builds/wtf-plugin-sports.cjs"
      }
    }
  },
  "main": "./builds/wtf-plugin-sports.cjs",
  "module": "./builds/wtf-plugin-sports.mjs",
  "types": "./types/index.d.cts",
  "scripts": {
    "watch": "node --watch ./scratch.js",
    "build": "node ./scripts/version.js && rollup -c",
    "test": "tape --strict \"tests/**/*.test.js\" | tap-dancer",
    "testb": "TESTENV=prod tape --strict \"tests/**/*.test.js\" | tap-dancer",
    "version": "node ./scripts/version.js",
    "write:all": "node ./scripts/write-db.js all",
    "write:dump": "node ./scripts/write-db.js dump",
    "write:mlb": "node ./scripts/write-db.js mlb",
    "write:nhl": "node ./scripts/write-db.js nhl",
    "write:nba": "node ./scripts/write-db.js nba",
    "write:nfl": "node ./scripts/write-db.js nfl",
    "write:mls": "node ./scripts/write-db.js mls",
    "write:wnba": "node ./scripts/write-db.js wnba",
    "write:nwsl": "node ./scripts/write-db.js nwsl",
    "write:pwhl": "node ./scripts/write-db.js pwhl",
    "write:cfl": "node ./scripts/write-db.js cfl"
  },
  "files": [
    "builds",
    "src",
    "types"
  ],
  "devDependencies": {
    "@duckdb/node-api": "2.0.0-r.1",
    "wtf_wikipedia": "workspace:*"
  },
  "peerDependencies": {
    "wtf_wikipedia": ">=9.0.0"
  },
  "unpkg": "./builds/wtf-plugin-sports.min.js"
}

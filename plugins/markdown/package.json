{
  "name": "wtf-plugin-markdown",
  "description": "markdown plugin for wtf_wikipedia",
  "version": "1.0.1",
  "type": "module",
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "unpkg": "./builds/wtf-plugin-markdown.min.js",
  "module": "./builds/wtf-plugin-markdown.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.ts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./builds/wtf-plugin-markdown.cjs"
      }
    }
  },
  "author": "Spencer Kelly (spencermountain)",
  "homepage": "https://github.com/spencermountain/wtf_wikipedia/plugins/markdown#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spencermountain/wtf_wikipedia.git"
  },
  "scripts": {
    "watch": "amble ./scratch.js",
    "test": "tape ./tests/**/*.test.js | tap-dancer",
    "testb": "TESTENV=prod tape ./tests/**/*.test.js | tap-dancer",
    "build": "rollup -c"
  },
  "files": [
    "types",
    "builds",
    "src"
  ],
  "prettier": {
    "trailingComma": "none",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true,
    "printWidth": 100
  },
  "peerDependencies": {
    "wtf_wikipedia": ">=9.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "29.0.3",
    "rollup": "4.62.2",
    "rollup-plugin-filesize-check": "1.2.0",
    "rollup-plugin-terser": "7.0.2",
    "tap-dancer": "0.3.4",
    "tape": "5.10.2"
  },
  "license": "MIT"
}

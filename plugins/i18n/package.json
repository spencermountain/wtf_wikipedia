{
  "name": "wtf-plugin-i18n",
  "version": "2.0.0",
  "description": "i18n plugin for wtf_wikipedia",
  "license": "MIT",
  "repository": "github:spencermountain/wtf_wikipedia",
  "homepage": "https://github.com/spencermountain/wtf_wikipedia/plugins/i18n#readme",
  "author": "Spencer Kelly <spencermountain@gmail.com> (https://spencermountain.dev)",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.ts",
        "default": "./builds/wtf-plugin-i18n.mjs"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./builds/wtf-plugin-i18n.cjs"
      }
    },
    "./package.json": "./package.json",
    "./words": {
      "types": "./types/words.d.ts",
      "default": "./src/words/index.js"
    },
    "./*": {
      "types": "./types/lang.d.ts",
      "default": "./src/langs/*/index.js"
    }
  },
  "main": "./builds/wtf-plugin-i18n.cjs",
  "module": "./builds/wtf-plugin-i18n.mjs",
  "types": "./types/index.d.cts",
  "sideEffects": false,
  "scripts": {
    "build": "node ./scripts/version.js && rollup -c",
    "data": "node ./scripts/01-fetch-sitelinks.js && node ./scripts/02-fetch-redirects.js && node ./scripts/03-fetch-templatedata.js && node ./scripts/04-diff.js",
    "data:diff": "node ./scripts/04-diff.js",
    "test": "tape --strict \"tests/**/*.test.js\" | tap-dancer",
    "testb": "TESTENV=prod tape --strict \"tests/**/*.test.js\" | tap-dancer",
    "version": "node ./scripts/version.js"
  },
  "files": [
    "builds",
    "src",
    "types"
  ],
  "devDependencies": {
    "wtf_wikipedia": "workspace:*"
  },
  "peerDependencies": {
    "wtf_wikipedia": ">=9.0.0"
  },
  "unpkg": "./builds/wtf-plugin-i18n.min.js"
}

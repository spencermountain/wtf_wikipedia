{
  "name": "wtf-plugin-classify",
  "version": "3.0.0",
  "description": "basic classifier for wikipedia articles",
  "license": "MIT",
  "repository": "github:spencermountain/wtf_wikipedia",
  "homepage": "https://github.com/spencermountain/wtf_wikipedia/plugins/classify#readme",
  "author": "Spencer Kelly <spencermountain@gmail.com> (https://spencermountain.dev)",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.ts",
        "default": "./builds/wtf-plugin-classify.mjs"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./builds/wtf-plugin-classify.cjs"
      }
    }
  },
  "main": "./builds/wtf-plugin-classify.cjs",
  "module": "./builds/wtf-plugin-classify.mjs",
  "types": "./types/index.d.cts",
  "sideEffects": false,
  "scripts": {
    "build": "rollup -c",
    "test": "node ../../scripts/test.js source",
    "test:built": "node ../../scripts/test.js built",
    "test:package": "node ../../scripts/test-package.js",
    "test:all": "pnpm run build && pnpm test && pnpm run test:built && pnpm run test:package",
    "fetch:test": "node ./tests/fetch-test.js",
    "schema": "node ./schema/_print.js"
  },
  "files": [
    "builds",
    "schema",
    "src",
    "types"
  ],
  "devDependencies": {
    "wtf_wikipedia": "workspace:*"
  },
  "peerDependencies": {
    "wtf_wikipedia": ">=9.0.0"
  },
  "unpkg": "./builds/wtf-plugin-classify.min.js"
}

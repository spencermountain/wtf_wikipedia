{
  // checks the bundled plugins' type declarations against the local ./types
  // (each plugin's own node_modules holds a published wtf_wikipedia, so the
  //  paths entry pins every file in this compile to the local declarations)
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "wtf_wikipedia": ["../../types/index.d.ts"],
      "wtf-plugin-html": ["../../plugins/html/index.d.ts"],
      "wtf-plugin-api": ["../../plugins/api/index.d.ts"],
      "wtf-plugin-sports": ["../../plugins/sports/index.d.ts"]
    }
  },
  "files": ["./plugins.mts"]
}
